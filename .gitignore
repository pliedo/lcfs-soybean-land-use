data/raw/cdl_cache/
data/raw/cdl_rasters/
data/raw/*.zip

# Cleaned data are generated by code.
data/clean/*
!data/clean/.gitkeep
!data/clean/crop_outcomes_exclusive.csv

# Generated output
output/*
!output/.gitkeep
!output/diagnostics/
!output/diagnostics/**

# System files
.DS_Store
Thumbs.db
