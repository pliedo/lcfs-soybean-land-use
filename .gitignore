# Local R session files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Dependency library and pipeline cache
renv/library/
renv/staging/
_targets/
.tar/
*.Rproj

# Source inputs are versioned when publicly redistributable or project-created.
# Large request caches / downloaded rasters are regenerated locally.
data/raw/cdl_cache/
data/raw/cdl_rasters/
data/raw/*.zip

# Cleaned data are generated by code.
data/clean/*
!data/clean/.gitkeep

# Generated output
output/*
!output/.gitkeep

# System files
.DS_Store
Thumbs.db
